{
  "openapi": "3.0.3",
  "info": { "title": "Veltro Messaging Service API", "version": "1.0.0", "description": "Coach-member conversations. History is stateless (stored client-side is not required — full history is in the database). Unread counts maintained per conversation." },
  "servers": [{ "url": "http://localhost:8087", "description": "Local development" }],
  "tags": [{ "name": "Conversations" }],
  "paths": {
    "/api/v1/conversations": {
      "get": { "tags": ["Conversations"], "summary": "List conversations for current user", "description": "Returns conversations where the current user (X-User-Id) is either the member or coach, ordered by lastMessageAt DESC.", "parameters": [{ "in": "header", "name": "X-User-Id", "required": true, "schema": { "type": "integer" } }, { "in": "header", "name": "X-User-Role", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Conversation list with unreadCount for current user" } } },
      "post": { "tags": ["Conversations"], "summary": "Start a new conversation (MEMBER initiates with coachId)", "description": "Idempotent: returns the existing conversation if one already exists between this member and coach.", "parameters": [{ "in": "header", "name": "X-User-Id", "required": true, "schema": { "type": "integer" } }, { "in": "header", "name": "X-User-Role", "required": true, "schema": { "type": "string", "enum": ["MEMBER"] } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "properties": { "coachId": { "type": "integer" } }, "required": ["coachId"] } } } }, "responses": { "201": { "description": "Conversation created or existing one returned" } } }
    },
    "/api/v1/conversations/unread-count": {
      "get": { "tags": ["Conversations"], "summary": "Total unread messages for current user (for nav badge)", "description": "Returns sum of unreadCountMember or unreadCountCoach across all conversations. Poll every 30 seconds.", "parameters": [{ "in": "header", "name": "X-User-Id", "required": true, "schema": { "type": "integer" } }, { "in": "header", "name": "X-User-Role", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Unread count", "content": { "application/json": { "schema": { "properties": { "data": { "properties": { "unreadCount": { "type": "integer" } } } } } } } } }
    },
    "/api/v1/conversations/read-all": {
      "put": { "tags": ["Conversations"], "summary": "Mark all conversations as read for current user", "parameters": [{ "in": "header", "name": "X-User-Id", "required": true, "schema": { "type": "integer" } }, { "in": "header", "name": "X-User-Role", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "All read" } } }
    },
    "/api/v1/conversations/{id}/messages": {
      "get": { "tags": ["Conversations"], "summary": "Get paginated messages (oldest first)", "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }, { "in": "header", "name": "X-User-Id", "required": true, "schema": { "type": "integer" } }, { "in": "header", "name": "X-User-Role", "required": true, "schema": { "type": "string" } }, { "in": "query", "name": "page", "schema": { "type": "integer", "default": 0 } }, { "in": "query", "name": "size", "schema": { "type": "integer", "default": 30 } }], "responses": { "200": { "description": "Paginated message list ordered by sentAt ASC" } } },
      "post": { "tags": ["Conversations"], "summary": "Send a message", "description": "Increments unread count for the recipient. Publishes MessageReceivedEvent to RabbitMQ.", "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }, { "in": "header", "name": "X-User-Id", "required": true, "schema": { "type": "integer" } }, { "in": "header", "name": "X-User-Role", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "properties": { "content": { "type": "string", "maxLength": 5000 } }, "required": ["content"] } } } }, "responses": { "201": { "description": "Message sent" } } }
    },
    "/api/v1/conversations/{id}/read": {
      "put": { "tags": ["Conversations"], "summary": "Mark all messages in a conversation as read for current user", "description": "Resets unreadCount for the current user to 0 and sets readAt on unread messages.", "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }, { "in": "header", "name": "X-User-Id", "required": true, "schema": { "type": "integer" } }, { "in": "header", "name": "X-User-Role", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Marked as read" } } }
    }
  },
  "components": {
    "schemas": {
      "ConversationResponse": { "type": "object", "properties": { "id": { "type": "integer" }, "memberId": { "type": "integer" }, "coachId": { "type": "integer" }, "lastMessageAt": { "type": "string", "format": "date-time", "nullable": true }, "lastMessagePreview": { "type": "string", "nullable": true }, "unreadCount": { "type": "integer" }, "createdAt": { "type": "string", "format": "date-time" } } },
      "MessageResponse": { "type": "object", "properties": { "id": { "type": "integer" }, "conversationId": { "type": "integer" }, "senderId": { "type": "integer" }, "senderRole": { "type": "string", "enum": ["MEMBER","COACH"] }, "content": { "type": "string" }, "sentAt": { "type": "string", "format": "date-time" }, "readAt": { "type": "string", "format": "date-time", "nullable": true } } }
    }
  }
}
