[
  {
    "id": "flow-nfc-simulator",
    "type": "tab",
    "label": "NFC Scan Simulator",
    "disabled": false,
    "info": "Simulates NFC card scans for 5 virtual cards (card001-card005). Toggle between IN/OUT direction on each click."
  },
  {
    "id": "inject-card001",
    "type": "inject",
    "z": "flow-nfc-simulator",
    "name": "Scan card001",
    "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
    "repeat": "",
    "crontab": "",
    "once": false,
    "payload": "{\"cardUid\": \"card001\", \"direction\": \"IN\"}",
    "payloadType": "json",
    "x": 130,
    "y": 80,
    "wires": [["fn-toggle-direction"]]
  },
  {
    "id": "inject-card002",
    "type": "inject",
    "z": "flow-nfc-simulator",
    "name": "Scan card002",
    "props": [{"p": "payload"}],
    "payload": "{\"cardUid\": \"card002\", \"direction\": \"IN\"}",
    "payloadType": "json",
    "x": 130,
    "y": 140,
    "wires": [["fn-toggle-direction"]]
  },
  {
    "id": "inject-card003",
    "type": "inject",
    "z": "flow-nfc-simulator",
    "name": "Scan card003",
    "props": [{"p": "payload"}],
    "payload": "{\"cardUid\": \"card003\", \"direction\": \"IN\"}",
    "payloadType": "json",
    "x": 130,
    "y": 200,
    "wires": [["fn-toggle-direction"]]
  },
  {
    "id": "inject-card004",
    "type": "inject",
    "z": "flow-nfc-simulator",
    "name": "Scan card004",
    "props": [{"p": "payload"}],
    "payload": "{\"cardUid\": \"card004\", \"direction\": \"IN\"}",
    "payloadType": "json",
    "x": 130,
    "y": 260,
    "wires": [["fn-toggle-direction"]]
  },
  {
    "id": "inject-card005",
    "type": "inject",
    "z": "flow-nfc-simulator",
    "name": "Scan card005",
    "props": [{"p": "payload"}],
    "payload": "{\"cardUid\": \"card005\", \"direction\": \"IN\"}",
    "payloadType": "json",
    "x": 130,
    "y": 320,
    "wires": [["fn-toggle-direction"]]
  },
  {
    "id": "fn-toggle-direction",
    "type": "function",
    "z": "flow-nfc-simulator",
    "name": "Toggle IN/OUT",
    "func": "var state = flow.get(msg.payload.cardUid) || 'OUT';\nvar next = (state === 'OUT') ? 'IN' : 'OUT';\nflow.set(msg.payload.cardUid, next);\nmsg.payload.direction = next;\nmsg.headers = {\n  'Content-Type': 'application/json',\n  'Authorization': 'Bearer ' + env.get('VELTRO_JWT')\n};\nreturn msg;",
    "outputs": 1,
    "x": 340,
    "y": 200,
    "wires": [["http-entry"]]
  },
  {
    "id": "http-entry",
    "type": "http request",
    "z": "flow-nfc-simulator",
    "name": "POST /api/v1/activity/entry",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://localhost:8080/api/v1/activity/entry",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "x": 560,
    "y": 200,
    "wires": [["fn-handle-entry-response", "debug-entry-raw"]]
  },
  {
    "id": "fn-handle-entry-response",
    "type": "function",
    "z": "flow-nfc-simulator",
    "name": "Format response",
    "func": "if (msg.statusCode === 201 && msg.payload && msg.payload.data) {\n  var entry = msg.payload.data;\n  msg.payload = '✅ ' + entry.direction + ' | ' + entry.memberName + ' @ ' + entry.timestamp;\n} else if (msg.statusCode === 422) {\n  msg.payload = '❌ Rejected: ' + (msg.payload.message || 'Unknown error');\n} else if (msg.statusCode === 503) {\n  msg.payload = '⚠️ Service unavailable: ' + (msg.payload.message || 'Card validation failed');\n} else {\n  msg.payload = '⚠️ HTTP ' + msg.statusCode + ': ' + JSON.stringify(msg.payload);\n}\nreturn msg;",
    "outputs": 1,
    "x": 780,
    "y": 170,
    "wires": [["debug-entry-display"]]
  },
  {
    "id": "debug-entry-display",
    "type": "debug",
    "z": "flow-nfc-simulator",
    "name": "Entry Result",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 980,
    "y": 170,
    "wires": []
  },
  {
    "id": "debug-entry-raw",
    "type": "debug",
    "z": "flow-nfc-simulator",
    "name": "Raw HTTP Response",
    "active": false,
    "tosidebar": true,
    "complete": "true",
    "targetType": "full",
    "x": 780,
    "y": 230,
    "wires": []
  },
  {
    "id": "flow-machine-session",
    "type": "tab",
    "label": "Machine Session Injector",
    "disabled": false,
    "info": "Injects randomized machine workout sessions for testing."
  },
  {
    "id": "inject-session",
    "type": "inject",
    "z": "flow-machine-session",
    "name": "Inject Session",
    "props": [{"p": "payload"}],
    "payload": "{\"memberId\": 1, \"machineType\": \"TREADMILL\"}",
    "payloadType": "json",
    "x": 130,
    "y": 120,
    "wires": [["fn-randomize-session"]]
  },
  {
    "id": "inject-bike-session",
    "type": "inject",
    "z": "flow-machine-session",
    "name": "Inject Bike Session",
    "props": [{"p": "payload"}],
    "payload": "{\"memberId\": 1, \"machineType\": \"BIKE\"}",
    "payloadType": "json",
    "x": 130,
    "y": 200,
    "wires": [["fn-randomize-session"]]
  },
  {
    "id": "inject-rowing-session",
    "type": "inject",
    "z": "flow-machine-session",
    "name": "Inject Rowing Session",
    "props": [{"p": "payload"}],
    "payload": "{\"memberId\": 1, \"machineType\": \"ROWING\"}",
    "payloadType": "json",
    "x": 130,
    "y": 280,
    "wires": [["fn-randomize-session"]]
  },
  {
    "id": "fn-randomize-session",
    "type": "function",
    "z": "flow-machine-session",
    "name": "Randomize values",
    "func": "var rand = function(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; };\nvar randFloat = function(min, max) { return Math.round((Math.random() * (max - min) + min) * 10) / 10; };\n\nmsg.payload.durationMinutes = rand(20, 90);\nmsg.payload.caloriesBurned = rand(200, 800);\nmsg.payload.avgHeartRate = rand(110, 175);\nmsg.payload.distanceKm = randFloat(1.0, 15.0);\nmsg.payload.memberEmail = 'demo@veltro.gym';\n\nmsg.headers = {\n  'Content-Type': 'application/json',\n  'Authorization': 'Bearer ' + env.get('VELTRO_JWT')\n};\n\nnode.warn('Sending session: ' + JSON.stringify(msg.payload));\nreturn msg;",
    "outputs": 1,
    "x": 360,
    "y": 200,
    "wires": [["http-session"]]
  },
  {
    "id": "http-session",
    "type": "http request",
    "z": "flow-machine-session",
    "name": "POST /api/v1/activity/session",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://localhost:8080/api/v1/activity/session",
    "tls": "",
    "persist": false,
    "x": 580,
    "y": 200,
    "wires": [["fn-handle-session-response"]]
  },
  {
    "id": "fn-handle-session-response",
    "type": "function",
    "z": "flow-machine-session",
    "name": "Format response",
    "func": "if (msg.statusCode === 201 && msg.payload && msg.payload.data) {\n  var s = msg.payload.data;\n  msg.payload = '✅ Session saved: ' + s.machineType + ' | ' + s.durationMinutes + 'min | ' + s.caloriesBurned + ' kcal | ' + s.distanceKm + 'km';\n} else {\n  msg.payload = '❌ Error ' + msg.statusCode + ': ' + JSON.stringify(msg.payload);\n}\nreturn msg;",
    "outputs": 1,
    "x": 800,
    "y": 200,
    "wires": [["debug-session"]]
  },
  {
    "id": "debug-session",
    "type": "debug",
    "z": "flow-machine-session",
    "name": "Session Result",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 990,
    "y": 200,
    "wires": []
  }
]
